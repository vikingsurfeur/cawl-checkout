{
	"name": "vikingsurfeur/cawl-checkout",
	"description": "Extension WordPress : inscriptions payantes réglées sur la page de paiement hébergée par CAWL.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.3",
		"online-payments/sdk-php": "11.2.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^11.5"
	},
	"autoload": {
		"classmap": [ "includes/" ]
	},
	"autoload-dev": {
		"classmap": [ "tests/Support/" ]
	},
	"config": {
		"platform": { "php": "8.3" },
		"sort-packages": true
	}
}
